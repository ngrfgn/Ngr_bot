from telegram import Update
from telegram.ext import ApplicationBuilder, CommandHandler, MessageHandler, ContextTypes, filters

BOT_TOKEN = "2107791918:AAG0HDm30ybqePql_mhonmmJrBTDLGhxwpE"

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("سلام! پیام‌تو بفرست :)")

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    message = update.message.text

    print(f"📨 New Message:\nFrom: {user.full_name} (@{user.username})\nID: {user.id}\nMessage: {message}")

    await update.message.reply_text(f"پیامت رسید! ممنون {user.first_name} ✨")

if __name__ == "__main__":
    app = ApplicationBuilder().token(BOT_TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))

    print("🤖 Bot is running...")
    app.run_polling()